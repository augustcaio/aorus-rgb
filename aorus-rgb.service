# Serviço de usuário: aplica o perfil de iluminação (aorus-rgb run) no login.
# Instalação: ./install-service.sh
[Unit]
Description=aorus-rgb: perfil de iluminação RGB da placa e das memórias
Documentation=https://github.com/augustcaio/aorus-rgb

[Service]
Type=exec
ExecStart=%h/.venvs/aorus-rgb/bin/aorus-rgb run
# o rainbow animado trata SIGINT (Ctrl+C) e encerra de forma limpa
KillSignal=SIGINT
# placa ou SMBus ainda indisponíveis no login: tenta de novo
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
