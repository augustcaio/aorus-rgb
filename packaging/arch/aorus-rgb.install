post_install() {
  modprobe i2c-dev 2>/dev/null || true
  udevadm trigger --subsystem-match=hidraw --subsystem-match=i2c-dev 2>/dev/null || true
  cat <<'MSG'
==> aorus-rgb instalado. Para o daemon restaurar as luzes no login (como
    usuário, sem sudo):
      systemctl --user enable --now aorus-rgb
==> As memórias RGB precisam do parâmetro de kernel acpi_enforce_resources=lax
    (UKI: /etc/kernel/cmdline + mkinitcpio -P; GRUB: GRUB_CMDLINE_LINUX_DEFAULT
    + grub-mkconfig). O pacote não altera o boot.
==> Quem usava a versão de desenvolvimento: rode ./install-service.sh --uninstall
    no repositório e remova /etc/udev/rules.d/70-aorus-rgb.rules.
MSG
}

post_upgrade() {
  udevadm trigger --subsystem-match=hidraw --subsystem-match=i2c-dev 2>/dev/null || true
  cat <<'MSG'
==> aorus-rgb atualizado. Como usuário:
      systemctl --user daemon-reload && systemctl --user restart aorus-rgb
==> 2.0: o serviço agora roda o daemon D-Bus. O perfil antigo (`profile` com
    um comando) foi substituído por perfis com nome: aorus-rgb profile save NOME
MSG
}
